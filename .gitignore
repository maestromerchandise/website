# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Secrets and configuration. Only the .env.example files are committed.
# Unanchored, so studio/.env is caught as well as the one at the root.
**/.env
**/.env.*
!**/.env.example

# Sanity build cache, written by the Studio.
.sanity/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Generated by `npm run seed:cli`, then handed to the Sanity CLI.
.seed.ndjson
