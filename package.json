{
  "name": "maestromerchandise",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "studio"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/generate-seo-files.mjs",
    "lint": "eslint .",
    "test": "node --test \"test/*.test.ts\"",
    "preview": "vite preview",
    "seed": "node --env-file=.env scripts/seed-content.mjs",
    "seed:cli": "node scripts/seed-content.mjs --out .seed.ndjson && sanity dataset import .seed.ndjson production --missing",
    "studio": "npm run dev --workspace studio",
    "studio:deploy": "npm run deploy --workspace studio",
    "cors": "sanity cors add",
    "cors:list": "sanity cors list"
  },
  "dependencies": {
    "motion": "^13.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sanity": "^4.15.0",
    "styled-components": "^6.1.19"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "playwright-core": "^1.62.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0"
  }
}
