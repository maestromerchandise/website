# Vite fingerprints every file under /assets/, so a given URL can never change
# content. Anything else must revalidate, or a deploy leaves stale HTML behind.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2|svg|png|jpg|webp|avif)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

# The Studio at /studio/ is a single-page app: it puts the document being edited
# in the path, so a refresh on /studio/structure/product;abc must still be served
# studio/index.html rather than 404. The site's own two pages are real files and
# are matched by the existing-file check before this ever applies.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^studio/ /studio/index.html [L]
</IfModule>
