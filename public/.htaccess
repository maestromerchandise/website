# Vite fingerprints every file under /assets/, so a given URL can never change
# content. Anything else must revalidate, or a deploy leaves stale HTML behind.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2|svg|png|jpg|webp|avif)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # Security headers, on every response.
  #
  # The content security policy itself is a meta tag in the site's own pages
  # rather than a header, so that /studio, which is Sanity's application and
  # talks to a long list of its hosts, is not caught by a policy written for the
  # catalogue. frame-ancestors cannot be set from a meta tag, which is why the
  # framing rule is here as X-Frame-Options and covers every page including the
  # Studio.
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()"
  # A year, and only on HTTPS. Subdomains are left out deliberately: this is set
  # for the site's own host, and a subdomain without a certificate would become
  # unreachable rather than insecure.
  Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"
  # The server's own advertisement of what it runs. Nothing needs it.
  Header always unset X-Powered-By
</IfModule>

# No directory listing anywhere, so a folder without an index file returns 403
# rather than printing what is inside it.
Options -Indexes

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

# The Studio at /studio/ is a single-page app: it puts the document being edited
# in the path, so a refresh on /studio/structure/product;abc must still be served
# studio/index.html rather than 404. The site's own two pages are real files and
# are matched by the existing-file check before this ever applies.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^studio/ /studio/index.html [L]
</IfModule>
