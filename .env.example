# Copy to .env and fill in by hand. Never commit .env.
#
# Every VITE_ prefixed value is baked into the JavaScript bundle at build time
# and is public. That is correct for the pair below: the Sanity dataset is
# public-read.
#
# Because they are baked in, these must be present wherever `npm run build`
# runs. For a Hostinger upload of dist/ that is your own machine; setting them
# in hPanel afterwards changes nothing. A build without them loads blank.
#
# The Google Analytics measurement id and the enquiry address are not here. Both
# are edited in Studio under Site settings, so the owner can change them without
# a redeploy.

VITE_SANITY_PROJECT_ID=your_sanity_project_id_here
VITE_SANITY_DATASET=production

# Build-time only, never in the bundle. The domain written into robots.txt and
# sitemap.xml, with https and no trailing slash. Left unset, both point at a
# placeholder domain. Use the production domain on the Netlify preview too.
SITE_URL=https://maestromerchandise.com

# Used only by scripts/seed-content.mjs on your own machine, never by the
# website, so never set it on Hostinger or Netlify. The missing VITE_ prefix is
# what keeps it out of the bundle, so do not add one.
SANITY_WRITE_TOKEN=your_sanity_write_token_here

# Not a variable, but the step people miss next to this file.
#
# Which browser origins may read this project is an allowlist held by Sanity,
# not something the site reads, so it cannot be set here. Register every origin
# you actually use, www and non-www separately, or both the Studio at /studio and
# the catalogue itself fail with a CORS error:
#
#   npm run cors -- http://localhost:5137 --credentials
#   npm run cors -- https://maestromerchandise.com --credentials
#   npm run cors -- https://www.maestromerchandise.com --credentials
#   npm run cors:list
