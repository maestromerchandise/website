# Copy to .env and fill in by hand. Never commit .env.
#
# Every VITE_ prefixed value is baked into the JavaScript bundle and is public.
# That is correct for all three below: the Sanity dataset is public-read, and a
# GA4 measurement id identifies a property without authorising anything.

VITE_SANITY_PROJECT_ID=your_sanity_project_id_here
VITE_SANITY_DATASET=production

# Google Analytics 4. Leave empty and no analytics script is loaded at all.
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Used only by scripts/seed-content.mjs, never by the website. The missing VITE_
# prefix is what keeps it out of the bundle, so do not add one.
SANITY_WRITE_TOKEN=your_sanity_write_token_here

# Not a variable, but the step people miss next to this file.
#
# Which browser origins may read this project is an allowlist held by Sanity,
# not something the site reads, so it cannot be set here. Register every origin
# you actually use or both the Studio at /studio and the catalogue itself fail
# with a CORS error:
#
#   npm run cors -- http://localhost:5173 --credentials
#   npm run cors -- https://www.yourdomain.com --credentials
#   npm run cors:list
